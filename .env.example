# =============================================================================
# Pace Environment Variables
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database (Supabase or standard PostgreSQL)
# Example Supabase direct or pooler connection URL:
# Transaction pooler (Port 6543) or Session pooler (Port 5432):
# postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/productivity_app

# Supabase Authentication & API Credentials
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://bzxqwgofanvzoanxfepl.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# (Optional) Supabase JWT Secret for direct local signature validation
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Testing / Development Fallback Flags
ALLOW_MOCK_AUTH=false

# Frontend Public Variables (used by Vite in client/.env)
# VITE_SUPABASE_URL=https://bzxqwgofanvzoanxfepl.supabase.co
# VITE_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# VITE_API_URL=/api
