{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/server",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./client/src/*"],
      "@server/*": ["./server/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["server/src/**/*", "server/tests/**/*", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
